# GorkhaTV — required configuration
#
# IMPORTANT: Cloudflare Pages does NOT read a .env file at runtime. This file
# is reference documentation only, listing every variable the app needs.
#   - Local dev:  put real values in `.dev.vars` (repo root, gitignored) for
#                 the Pages project, and `worker-sync/.dev.vars` for the sync
#                 worker. `wrangler pages dev` / `wrangler dev` load these
#                 automatically.
#   - Production: set these in the Cloudflare Pages dashboard
#                 (Settings → Environment variables) and, for worker-sync,
#                 via `wrangler secret put <NAME> --config worker-sync/wrangler.toml`.

# ── Secrets (never commit real values, never expose to client-side code) ──

# YouTube Data API v3 key. Get one at https://console.cloud.google.com/apis/credentials
# after enabling "YouTube Data API v3" on a Google Cloud project. Needed by
# BOTH the Pages project (admin manual-add/approve actions) and worker-sync.
YOUTUBE_API_KEY=

# Admin login password, stored as a PBKDF2 hash — never store the raw password.
# Generate with: node scripts/hash-password.mjs "your-chosen-admin-password"
ADMIN_PASSWORD_HASH=

# Random long strings used to sign session cookies. Generate e.g. with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# Keep these two DIFFERENT from each other — admin and viewer sessions are
# signed with separate keys so a leak of one cannot forge the other.
ADMIN_SESSION_SECRET=
SESSION_SECRET=

# ── Public config (safe to expose client-side) ──

# Google Cloud OAuth 2.0 Client ID (Web application type), used only for
# "Sign in with Google" (Google Identity Services). No client secret is
# needed for this flow. Create one at https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=

# Self-enforced daily YouTube API quota ceiling (of the 10,000 free units/day)
# the sync worker will not exceed, to leave headroom for admin actions.
SYNC_DAILY_QUOTA_SOFT_CAP=8000

PUBLIC_SITE_URL=https://gorkhatv.site

# ── D1 database ──
# Not an env var — configured as a binding named `DB` in wrangler.toml
# (root, for Pages) and worker-sync/wrangler.toml (for the sync worker).
# Create the database once with: wrangler d1 create gorkhatv
# then paste the returned database_id into both wrangler.toml files.
