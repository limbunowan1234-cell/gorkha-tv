# Security headers for every response. Cloudflare Pages applies these on top
# of its own defaults (HTTPS/HSTS is enforced by Cloudflare already).
#
# Note on Content-Security-Policy: script-src/style-src include 'unsafe-inline'
# because the site's pages use inline onclick handlers and inline <style>
# blocks throughout (a pre-existing pattern from before this rebuild, not
# something Stage E introduces) — removing it would require rewriting every
# page's event handling to addEventListener-only, which is a structural
# change out of scope for a hardening pass. The policy still meaningfully
# restricts object embeds, base-tag injection, and framing.
#
# 'unsafe-eval' was added specifically for the Infolinks ad script
# (resources.infolinks.com) — confirmed directly that its library throws
# "Uncaught EvalError" and fails to run without it. This is a real,
# deliberate weakening (script-src is already 'unsafe-inline', so this is
# incremental, not a first departure) — worth knowing if this site ever
# drops Infolinks, since it could be removed again at that point.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://accounts.google.com https://pagead2.googlesyndication.com https://www.youtube.com https://s.ytimg.com https://resources.infolinks.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; frame-src https://www.youtube.com https://accounts.google.com; connect-src 'self' https://accounts.google.com https://www.youtube.com; base-uri 'self'; object-src 'none'; frame-ancestors 'self'

# router.js and playerBar.js can't be cache-busted via a "?v=" query string
# on their <script src> tags the way every other local JS/CSS file now is
# (scripts/bump-asset-version.mjs) — both are ALSO relatively imported by
# other local JS files (watch.js, genre.js, home.js, chart.js all do
# `import ... from './router.js'` / './playerBar.js'), and a relative
# import resolves without any query string from its importer, so a
# versioned <script> tag and the bare relative import would load as two
# separate module instances — a correctness bug (duplicate router.js
# teardown registry, duplicate playerBar.js player/iframe state), not just
# a caching nicety. Confirmed directly this session: Cloudflare's default
# `public, max-age=14400` on static assets kept a browser serving an
# hours-stale playerBar.js — missing fixes already live on the server —
# with no warning, for up to 4 hours after each deploy. `no-cache` (not
# `no-store`) still lets the browser cache the response, but forces a
# revalidation round-trip on every request, so a new deploy's content is
# never more than one request away instead of up to 4 hours away.
/js/router.js
  Cache-Control: no-cache

/js/playerBar.js
  Cache-Control: no-cache

# Never cache personalized/sensitive API responses, regardless of any
# per-route Cache-Control an individual Function might also set.
/api/admin/*
  Cache-Control: no-store

/api/auth/*
  Cache-Control: no-store

/api/favourites/*
  Cache-Control: no-store
