# GorkhaTV is a multi-page static site — Cloudflare Pages serves .html files
# directly, no catch-all needed. These are 301s for pages removed during the
# Appwrite → YouTube-discovery rebuild, so old bookmarks/links 404 gracefully
# instead of dead-ending.

/pages/artists.html            /                          301
/pages/artist.html             /                          301
/pages/video.html              /                          301
/pages/creator-dashboard.html  /pages/submit-channel.html 301
/pages/my-credits.html         /                          301
/pages/auth-callback.html      /                          301
/pages/admin-content.html      /pages/admin-videos.html   301
